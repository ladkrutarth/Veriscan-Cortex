# Copy to .env and adjust. Never commit .env. All flags are optional.

# --- Models ---
VERISCAN_FAST_MODE=0              # 1 = TinyLlama 1.1B instead of Llama-3-8B
# VERISCAN_LLM_MODEL=mlx-community/Meta-Llama-3-8B-Instruct-4bit
VERISCAN_SKIP_VISION=0            # 1 = don't load LLaVA
# DECEPTION_LLM_DISABLED=0
# DECEPTION_LLM_MODEL=

# --- Agents ---
ENABLE_AGENTIC_ADVISOR=1
ENABLE_MULTI_AGENT_ADVISOR=0
VERISCAN_TRAJECTORY_LOG=1

# --- API ---
VERISCAN_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING
VERISCAN_LOG_FORMAT=text          # text | json
VERISCAN_CORS_ORIGINS=http://localhost:8502,http://127.0.0.1:8502
VERISCAN_MAX_UPLOAD_FILES=10
VERISCAN_MAX_UPLOAD_MB=25

# --- Dashboard ---
VERISCAN_API_URL=http://127.0.0.1:8000

# --- Snowflake (optional; leave blank to stay fully local) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
